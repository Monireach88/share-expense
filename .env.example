# Django
DJANGO_DEBUG=true
# Required when DJANGO_DEBUG=false. Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=share-expense.local,localhost
# Full origins, comma-separated, e.g. https://expense.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=http://share-expense.local
TIME_ZONE=Asia/Phnom_Penh
LOG_LEVEL=INFO

# Database (the share-expense-postgres alias avoids clashes on the shared proxy-network)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=share_expense
DATABASE_URL=postgres://postgres:postgres@share-expense-postgres:5432/share_expense

# Login rate limit: failures before a username + IP pair is locked for 1 hour
AXES_FAILURE_LIMIT=5
# Header with the real visitor IP, so a lock hits the attacker, not everyone behind the proxy.
# nginx-proxy (dev): HTTP_X_FORWARDED_FOR. Cloudflare Tunnel (prod): HTTP_CF_CONNECTING_IP.
CLIENT_IP_HEADER=HTTP_X_FORWARDED_FOR

# Writing suggestions under the expense description (DeepSeek chat API). Empty turns them off.
# Key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# AI requests the whole site may make per day (suggestions and "Add with AI" together).
DEEPSEEK_DAILY_LIMIT=500

# Market exchange rates suggested on the New trip and Trip settings pages (ExchangeRate-API's
# open endpoint, no key; the server asks once per base currency per day). Empty turns them off.
EXCHANGE_RATES_URL=https://open.er-api.com/v6/latest

# Sign in with Google. Empty GOOGLE_CLIENT_ID hides the button. Create an OAuth client
# (type "Web application") at https://console.cloud.google.com/apis/credentials with the
# redirect URI https://<domain>/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Personal invite email (SMTP). Empty EMAIL_HOST turns email off: invites still work and the
# Owner sends the link themselves. Any SMTP provider works; the example is Zoho Mail
# (smtp.zoho.com, or smtp.zoho.eu / smtp.zoho.in for those data centers; needs a plan with
# SMTP access and an application-specific password). Set only one of EMAIL_USE_SSL and
# EMAIL_USE_TLS to true. Gmail: smtp.gmail.com, port 587, EMAIL_USE_TLS=true, an app password.
EMAIL_HOST=
# EMAIL_HOST=smtp.zoho.com
EMAIL_PORT=465
EMAIL_USE_SSL=true
EMAIL_USE_TLS=false
# The mailbox address you log in to the provider with
EMAIL_HOST_USER=
# An application-specific password for this app (never the account password)
EMAIL_HOST_PASSWORD=
# Seconds to wait for the SMTP server
EMAIL_TIMEOUT=10
# The sender: the mailbox address or one of its aliases (most providers refuse other senders)
DEFAULT_FROM_EMAIL=Share Expense <you@example.com>

# Production and staging only (docker-compose.prod.yml, docker-compose.staging.yml; each has its own file and tunnel)
# Token of your Cloudflare Tunnel: cloudflared tunnel token <tunnel-name>
CLOUDFLARE_TUNNEL_TOKEN=
GUNICORN_WORKERS=2
# HTTPS-only period browsers remember, in seconds. Raise to 31536000 once HTTPS works.
DJANGO_SECURE_HSTS_SECONDS=3600
