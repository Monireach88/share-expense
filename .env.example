# Django
DJANGO_DEBUG=true
# Required when DJANGO_DEBUG=false. Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=share-expense.local,localhost
# Full origins, comma-separated, e.g. https://expense.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=http://share-expense.local
TIME_ZONE=Asia/Phnom_Penh
LOG_LEVEL=INFO

# Database (the share-expense-postgres alias avoids clashes on the shared proxy-network)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=share_expense
DATABASE_URL=postgres://postgres:postgres@share-expense-postgres:5432/share_expense

# Login rate limit: failures before a username + IP pair is locked for 1 hour
AXES_FAILURE_LIMIT=5
# Header with the real visitor IP, so a lock hits the attacker, not everyone behind the proxy.
# nginx-proxy (dev): HTTP_X_FORWARDED_FOR. Cloudflare Tunnel (prod): HTTP_CF_CONNECTING_IP.
CLIENT_IP_HEADER=HTTP_X_FORWARDED_FOR

# Production only (docker-compose.prod.yml)
# Token of your Cloudflare Tunnel: cloudflared tunnel token <tunnel-name>
CLOUDFLARE_TUNNEL_TOKEN=
GUNICORN_WORKERS=2
# HTTPS-only period browsers remember, in seconds. Raise to 31536000 once HTTPS works.
DJANGO_SECURE_HSTS_SECONDS=3600
