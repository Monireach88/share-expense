#: apps/accounts/adapters.py:28 apps/accounts/forms.py:8
#: apps/trips/invites.py:261
msgid "This account is closed. Ask the admin to restore it."
msgstr "គណនីនេះត្រូវបានបិទ។ សូមស្នើអ្នកគ្រប់គ្រងឱ្យស្ដារវាវិញ។"

#: apps/accounts/adapters.py:83
#, python-format
msgid ""
"This invite is for %(address)s, but you used another Google account. Sign "
"out of Google, then open the invite link again and choose the invited "
"address."
msgstr ""
"ការអញ្ជើញនេះសម្រាប់ %(address)s ប៉ុន្តែអ្នកបានប្រើគណនី Google ផ្សេង។ "
"សូមចេញពីគណនី Google រួចបើកតំណអញ្ជើញម្ដងទៀត ហើយជ្រើសរើសអាសយដ្ឋានដែលបានអញ្ជើញ។"

#: apps/accounts/adapters.py:93
msgid ""
"No account uses this Google account. If you have a username and password, "
"log in with them and link Google from the account menu. To join a trip, ask "
"its Owner for an invite."
msgstr ""
"គ្មានគណនីណាប្រើគណនី Google នេះទេ។ ប្រសិនបើអ្នកមានឈ្មោះអ្នកប្រើ "
"និងពាក្យសម្ងាត់ សូមចូលគណនីដោយប្រើវា រួចភ្ជាប់ Google ពីម៉ឺនុយគណនី។ "
"ដើម្បីចូលរួមដំណើរកម្សាន្ត សូមសុំការអញ្ជើញពីម្ចាស់ដំណើរកម្សាន្ត។"

#: apps/accounts/admin.py:17 templates/trips/people.html:45
msgid "Closed"
msgstr "បានបិទ"

#: apps/accounts/admin.py:19
msgid "closed"
msgstr "បានបិទ"

#: apps/accounts/admin.py:34
#, python-format
msgid "Trip “%(trip)s”, owned by %(user)s: make someone else its Owner first."
msgstr ""
"ដំណើរកម្សាន្ត “%(trip)s” ដែលមាន %(user)s ជាម្ចាស់៖ "
"សូមកំណត់អ្នកផ្សេងជាម្ចាស់ជាមុនសិន។"

#: apps/accounts/admin.py:40
msgid "Approve selected sign-up requests"
msgstr "អនុម័តសំណើចុះឈ្មោះដែលបានជ្រើសរើស"

#: apps/accounts/admin.py:45
#, python-format
msgid "%(count)d account(s) approved."
msgstr "បានអនុម័តគណនីចំនួន %(count)d។"

#: apps/accounts/admin.py:48
msgid "Restore selected closed accounts"
msgstr "ស្ដារគណនីដែលបានបិទដែលបានជ្រើសរើសវិញ"

#: apps/accounts/admin.py:52
#, python-format
msgid "%(count)d account(s) restored."
msgstr "បានស្ដារគណនីចំនួន %(count)d វិញ។"

#: apps/accounts/closing.py:37
#, python-format
msgid "%(trips)s and %(last)s"
msgstr "%(trips)s និង %(last)s"

#: apps/accounts/closing.py:43
#, python-format
msgid "You are the Owner of %(trips)s. Make someone else the Owner first."
msgstr "អ្នកជាម្ចាស់នៃ %(trips)s។ សូមកំណត់អ្នកផ្សេងជាម្ចាស់ជាមុនសិន។"

#: apps/accounts/forms.py:41
msgid "At least 8 characters, not only numbers."
msgstr "ត្រូវមានយ៉ាងហោចណាស់ 8 តួអក្សរ ហើយមិនអាចមានតែលេខទេ។"

#: apps/accounts/forms.py:42
msgid "Type the new password again."
msgstr "វាយពាក្យសម្ងាត់ថ្មីម្ដងទៀត។"

#: apps/accounts/forms.py:48
msgid "Your username"
msgstr "ឈ្មោះអ្នកប្រើរបស់អ្នក"

#: apps/accounts/forms.py:59
#, python-format
msgid "Type “%(username)s” to confirm."
msgstr "វាយ “%(username)s” ដើម្បីបញ្ជាក់។"

#: apps/accounts/models.py:20 config/django_messages.py:188
msgid "username"
msgstr "ឈ្មោះអ្នកប្រើ"

#: apps/accounts/models.py:28
msgid "closed on"
msgstr "បិទនៅថ្ងៃ"

#: apps/accounts/models.py:33
msgid "language"
msgstr "ភាសា"

#: apps/accounts/usernames.py:16
msgid "This username is taken."
msgstr "ឈ្មោះអ្នកប្រើនេះមានគេប្រើហើយ។"

#: apps/accounts/usernames.py:17
msgid "Use only the characters listed above."
msgstr "សូមប្រើតែតួអក្សរដែលបានរាយខាងលើ។"

#: apps/accounts/views.py:53
msgid "Your account is closed."
msgstr "គណនីរបស់អ្នកត្រូវបានបិទ។"

#: apps/disputes/models.py:22
msgctxt "dispute state"
msgid "Open"
msgstr "មិនទាន់ដោះស្រាយ"

#: apps/disputes/models.py:23
msgctxt "dispute state"
msgid "Resolved"
msgstr "បានដោះស្រាយ"

#: apps/disputes/models.py:24
msgctxt "dispute state"
msgid "Closed"
msgstr "បានបិទ"

#: apps/disputes/models.py:37
msgid "reason"
msgstr "មូលហេតុ"

#: apps/disputes/models.py:38
msgid "reason in English"
msgstr "មូលហេតុជាភាសាអង់គ្លេស"

#: apps/disputes/models.py:40
msgid "reason for closing"
msgstr "មូលហេតុនៃការបិទ"

#: apps/disputes/models.py:42
msgid "reason for closing in English"
msgstr "មូលហេតុនៃការបិទជាភាសាអង់គ្លេស"

#: apps/disputes/models.py:83
msgid "message"
msgstr "សារ"

#: apps/disputes/models.py:84
msgid "message in English"
msgstr "សារជាភាសាអង់គ្លេស"

#. Translators: stands for a person in: "<Owner>, the Owner, closed
#. <someone>'s dispute".
#: apps/disputes/rules.py:182 apps/trips/history.py:448
msgid "someone"
msgstr "នរណាម្នាក់"

#: apps/disputes/rules.py:185
#, python-format
msgid "%(who)s opened a dispute on %(label)s: %(detail)s"
msgstr "%(who)s បានបើកការជំទាស់លើ %(label)s៖ %(detail)s"

#: apps/disputes/rules.py:187
#, python-format
msgid "%(who)s wrote in the dispute on %(label)s: %(detail)s"
msgstr "%(who)s បានសរសេរក្នុងការជំទាស់លើ %(label)s៖ %(detail)s"

#: apps/disputes/rules.py:189 apps/trips/history.py:452
#, python-format
msgid "%(who)s resolved the dispute on %(label)s"
msgstr "%(who)s បានដោះស្រាយការជំទាស់លើ %(label)s"

#: apps/disputes/rules.py:191
#, python-format
msgid ""
"%(who)s, the Owner, closed %(opener)s’s dispute on %(label)s. Reason: "
"%(detail)s"
msgstr ""
"%(who)s ជាម្ចាស់ បានបិទការជំទាស់របស់ %(opener)s លើ %(label)s។ មូលហេតុ៖ "
"%(detail)s"

#: apps/disputes/rules.py:193 apps/trips/history.py:402
#, python-format
msgid "%(who)s settled the trip"
msgstr "%(who)s បានទូទាត់បញ្ចប់ដំណើរកម្សាន្ត"

#: apps/disputes/rules.py:194 apps/trips/history.py:403
#, python-format
msgid "%(who)s reopened the trip"
msgstr "%(who)s បានបើកដំណើរកម្សាន្តឡើងវិញ"

#: apps/disputes/rules.py:196
#, python-format
msgid "%(who)s added you to the trip"
msgstr "%(who)s បានបន្ថែមអ្នកទៅក្នុងដំណើរកម្សាន្ត"

#: apps/disputes/rules.py:197
#, python-format
msgid "%(who)s accepted your invite"
msgstr "%(who)s បានទទួលយកការអញ្ជើញរបស់អ្នក"

#: apps/disputes/rules.py:199
#, python-format
msgid ""
"%(who)s accepted your invite, but traveler %(detail)s could not be linked. "
"Link the right traveler on the Travelers page."
msgstr ""
"%(who)s បានទទួលយកការអញ្ជើញរបស់អ្នក ប៉ុន្តែមិនអាចភ្ជាប់អ្នកធ្វើដំណើរ "
"%(detail)s បានទេ។ សូមភ្ជាប់អ្នកធ្វើដំណើរដែលត្រឹមត្រូវនៅទំព័រអ្នកធ្វើដំណើរ។"

#: apps/disputes/rules.py:223
msgid "This dispute is resolved, so it takes no new messages."
msgstr "ការជំទាស់នេះបានដោះស្រាយហើយ ដូច្នេះមិនអាចផ្ញើសារថ្មីបានទៀតទេ។"

#: apps/disputes/rules.py:225
msgid "This dispute is closed, so it takes no new messages."
msgstr "ការជំទាស់នេះត្រូវបានបិទ ដូច្នេះមិនអាចផ្ញើសារថ្មីបានទៀតទេ។"

#: apps/disputes/rules.py:249
msgid "Write why you disagree with this expense."
msgstr "សូមសរសេរពីមូលហេតុដែលអ្នកមិនយល់ស្របនឹងការចំណាយនេះ។"

#: apps/disputes/rules.py:256
msgid "You already have an open dispute on this expense."
msgstr "អ្នកមានការជំទាស់មួយដែលមិនទាន់ដោះស្រាយលើការចំណាយនេះរួចហើយ។"

#: apps/disputes/rules.py:292
msgid "Write a message first."
msgstr "សូមសរសេរសារជាមុនសិន។"

#: apps/disputes/rules.py:347
msgid "Write the reason for closing this dispute."
msgstr "សូមសរសេរមូលហេតុនៃការបិទការជំទាស់នេះ។"

#: apps/disputes/rules.py:393
#, python-format
msgid "%(n)d open dispute"
msgid_plural "%(n)d open disputes"
msgstr[0] "ការជំទាស់មិនទាន់ដោះស្រាយចំនួន %(n)d"

#: apps/disputes/rules.py:401
msgid ""
"This traveler cannot be removed because an expense they are in has a "
"dispute."
msgstr ""
"មិនអាចដកអ្នកធ្វើដំណើរនេះចេញបានទេ "
"ព្រោះមានការជំទាស់លើការចំណាយមួយដែលពាក់ព័ន្ធនឹងគាត់។"

#: apps/disputes/rules.py:403
msgid ""
"This type cannot be removed because an expense of this type has a dispute."
msgstr "មិនអាចលុបប្រភេទនេះបានទេ ព្រោះការចំណាយមួយនៃប្រភេទនេះមានការជំទាស់។"

#: apps/disputes/rules.py:404
msgid ""
"This rate cannot be deleted because an expense in this currency has a "
"dispute."
msgstr ""
"មិនអាចលុបអត្រាប្ដូរប្រាក់នេះបានទេ "
"ព្រោះការចំណាយមួយជារូបិយប័ណ្ណនេះមានការជំទាស់។"

#: apps/disputes/views.py:120
msgid "Dispute opened."
msgstr "បានបើកការជំទាស់។"

#: apps/disputes/views.py:152
msgid "Dispute resolved."
msgstr "បានដោះស្រាយការជំទាស់។"

#: apps/disputes/views.py:169
msgid "Dispute closed."
msgstr "បានបិទការជំទាស់។"

#: apps/expenses/ai_fill.py:83
msgid "Describe the expense in a sentence."
msgstr "សូមរៀបរាប់ការចំណាយក្នុងមួយប្រយោគ។"

#: apps/expenses/ai_fill.py:102 apps/expenses/ai_fill.py:104
#: templates/expenses/form.html:118
msgid "The text could not be read. Try again."
msgstr "មិនអាចអានអត្ថបទបានទេ។ សូមព្យាយាមម្ដងទៀត។"

#: apps/expenses/ai_fill.py:106
msgid "This box only adds expenses."
msgstr "ប្រអប់នេះសម្រាប់តែបន្ថែមការចំណាយប៉ុណ្ណោះ។"

#: apps/expenses/ai_fill.py:113
msgid "the amount"
msgstr "ចំនួនទឹកប្រាក់"

#: apps/expenses/ai_fill.py:119
msgid "the currency"
msgstr "រូបិយប័ណ្ណ"

#: apps/expenses/ai_fill.py:122
#, python-format
msgid "the currency (%(code)s has no exchange rate in this trip)"
msgstr "រូបិយប័ណ្ណ (%(code)s មិនមានអត្រាប្ដូរប្រាក់ក្នុងដំណើរកម្សាន្តនេះទេ)"

#: apps/expenses/ai_fill.py:131 apps/expenses/ai_fill.py:141
msgid "who paid"
msgstr "អ្នកដែលបានបង់"

#: apps/expenses/ai_fill.py:138
#, python-format
msgid "who paid (no single traveler is called “%(name)s”)"
msgstr ""
"អ្នកដែលបានបង់ (មិនអាចកំណត់អ្នកធ្វើដំណើរតែម្នាក់តាមឈ្មោះ “%(name)s” បានទេ)"

#: apps/expenses/ai_fill.py:153
#, python-format
msgid "who it was for (no single traveler is called %(names)s)"
msgstr ""
"ចំណាយសម្រាប់នរណា (មិនអាចកំណត់អ្នកធ្វើដំណើរតែម្នាក់តាមឈ្មោះ %(names)s បានទេ)"

#: apps/expenses/ai_fill.py:159
msgid "who it was for"
msgstr "ចំណាយសម្រាប់នរណា"

#: apps/expenses/ai_fill.py:165
msgid "the type"
msgstr "ប្រភេទ"

#: apps/expenses/ai_fill.py:171
msgid "what was bought"
msgstr "អ្វីដែលបានទិញ"

#: apps/expenses/forms.py:41 apps/expenses/report.py:212
msgid "Description"
msgstr "ការពិពណ៌នា"

#: apps/expenses/forms.py:43 apps/expenses/report.py:40
#: apps/expenses/report.py:214 templates/expenses/_facts.html:9
msgid "Paid by"
msgstr "បង់ដោយ"

#: apps/expenses/forms.py:44 apps/expenses/report.py:215
#: templates/expenses/_facts.html:10
msgid "Split between"
msgstr "ចែកចំណាយរវាង"

#: apps/expenses/forms.py:45 apps/expenses/report.py:47
#: apps/expenses/report.py:213 templates/expenses/_facts.html:11
msgid "Type"
msgstr "ប្រភេទ"

#: apps/expenses/forms.py:46 apps/expenses/report.py:211
#: templates/expenses/_facts.html:12
msgid "Date"
msgstr "កាលបរិច្ឆេទ"

#: apps/expenses/forms.py:57
msgid "e.g. Taxi from the airport"
msgstr "ឧ. តាក់ស៊ីពីព្រលានយន្តហោះ"

#: apps/expenses/forms.py:87
#, python-format
msgid "Your account can add and change only expenses paid by %(name)s."
msgstr ""
"គណនីរបស់អ្នកអាចបន្ថែម និងកែប្រែបានតែការចំណាយដែលបង់ដោយ %(name)s ប៉ុណ្ណោះ។"

#: apps/expenses/forms.py:113
msgid "Enter an amount above zero."
msgstr "សូមបញ្ចូលចំនួនទឹកប្រាក់ធំជាងសូន្យ។"

#: apps/expenses/forms.py:120
